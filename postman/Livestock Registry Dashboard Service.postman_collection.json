  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Contract checks for every request. Keys per chart mirror CONTRACT in the service's tests/test_charts.py.",
          "const CONTRACT = {\"livestockKpis\": [\"animals\", \"breeds_tracked\", \"female_keepers\", \"holdings\", \"keepers\", \"species_tracked\", \"woredas_reporting\"], \"livestockBySpecies\": [\"animals\", \"keepers\", \"species\", \"species_code\"], \"livestockByBreed\": [\"animals\", \"breed\", \"breed_code\", \"species\"], \"livestockKeepersByRegion\": [\"animals\", \"farmers\", \"region\", \"region_code\"], \"livestockKeepersByZone\": [\"animals\", \"farmers\", \"zone\", \"zone_code\"], \"livestockKeepersByWoreda\": [\"animals\", \"farmers\", \"woreda\", \"woreda_code\"], \"livestockKeepersByKebele\": [\"animals\", \"farmers\", \"kebele\", \"kebele_code\"], \"livestockTopWoredas\": [\"animals\", \"farmers\", \"woreda\", \"woreda_code\"], \"herdHealthSplit\": [\"animals\", \"health_status\"], \"livestockVaccinationStatus\": [\"animals\", \"vaccination_status\"], \"livestockBySex\": [\"animals\", \"sex\"], \"livestockTrendByMonth\": [\"animals\", \"farmers\", \"holdings\", \"period\"], \"livestockByState\": [\"holdings\", \"state\"], \"livestockByRecordState\": [\"holdings\", \"record_state\"]};",
          "pm.test('status is 200', () => pm.response.to.have.status(200));",
          "const path = pm.request.url.getPath();",
          "if (path === '/health') {",
          "  pm.test('health reports ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
          "} else {",
          "  const chart = path.split('/').pop();",
          "  const rows = pm.response.json();",
          "  pm.test('body is an array', () => pm.expect(rows).to.be.an('array'));",
          "  const keys = CONTRACT[chart];",
          "  if (keys) {",
          "    pm.test('rows have exactly the contract keys', () => rows.forEach(r => pm.expect(Object.keys(r).sort()).to.eql(keys)));",
          "  }",
          "}"
        ]
      }
    }
  ],
