# Copy to .env for local use. Never commit real values: supply them from the
# deployment's secret store, or a local, uncommitted .env.

# Livestock registry database, using a role with SELECT on the lr_rpt_* reporting
# views. Format: postgresql://<user>@<host>:5432/<database>
DATABASE_URL=
# The password, kept out of the URL so it needs no URL-encoding.
PGPASSWORD=
# Connections per worker process (min kept open, max under load).
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# JSON list of origins allowed by CORS. Browsers should not call this service directly.
ALLOWED_ORIGINS=["http://localhost:3000"]
